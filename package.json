{
  "name": "convalt-energy-module-story",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --port 4173",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-brand.mjs",
    "assets:intro": "node scripts/prepare-intro.mjs",
    "assets:field": "node --max-old-space-size=8192 scripts/prepare-field.mjs",
    "capture:shots": "node scripts/capture.mjs shots",
    "capture:posters": "node scripts/capture.mjs posters",
    "capture:perf": "node scripts/capture.mjs perf",
    "capture:checks": "node scripts/capture.mjs checks",
    "assets:datacenter": "node scripts/prepare-datacenter.mjs",
    "assets:portfolio": "node scripts/prepare-portfolio.mjs",
    "layout:field": "node scripts/field-layout-report.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/fiber": "^9.8.0",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^0.22.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
